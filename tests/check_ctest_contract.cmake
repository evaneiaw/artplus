# Internal validator used by verify_ctest_contract.cmake, including its controls.
cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED INPUT_FILE OR NOT DEFINED BUILD_DIR)
    message(FATAL_ERROR "INPUT_FILE and BUILD_DIR are required")
endif()
file(READ "${INPUT_FILE}" discovery)
set(expected_names artplus.edit artplus.command artplus.pageview
    artplus.smoke artplus.import artplus.mainwindow artplus.colour artplus.transform_again)
string(JSON count LENGTH "${discovery}" tests)
if(NOT count EQUAL 8)
    message(FATAL_ERROR "Expected eight suites")
endif()
set(workdir "${BUILD_DIR}/tests/runtime")
foreach(i RANGE 0 7)
    string(JSON name GET "${discovery}" tests ${i} name)
    if(NOT name IN_LIST expected_names)
        message(FATAL_ERROR "Unexpected or duplicate suite: ${name}")
    endif()
    list(REMOVE_ITEM expected_names "${name}")
    string(REPLACE "artplus." "artplus_" executable "${name}")
    if(name STREQUAL "artplus.smoke")
        set(executable artplus_pdf_smoke)
    else()
        string(APPEND executable "_test")
    endif()
    set(expected_command "${BUILD_DIR}/bin/${executable}.exe")
    if(name MATCHES "^artplus[.](smoke|import|mainwindow)$")
        list(APPEND expected_command "${workdir}/artplus_edit_multipage_fixture.pdf")
        set(fixture_key FIXTURES_REQUIRED)
    elseif(name STREQUAL "artplus.edit")
        set(fixture_key FIXTURES_SETUP)
    else()
        set(fixture_key "")
    endif()
    string(JSON argc LENGTH "${discovery}" tests ${i} command)
    list(LENGTH expected_command expected_argc)
    if(NOT argc EQUAL expected_argc)
        message(FATAL_ERROR "${name}: unexpected command argument count")
    endif()
    math(EXPR last_arg "${argc} - 1")
    foreach(a RANGE 0 ${last_arg})
        string(JSON arg GET "${discovery}" tests ${i} command ${a})
        list(GET expected_command ${a} expected)
        if(NOT arg STREQUAL expected)
            message(FATAL_ERROR "${name}: unexpected command argument ${a}")
        endif()
    endforeach()
    string(JSON props GET "${discovery}" tests ${i} properties)
    string(JSON prop_count LENGTH "${props}")
    set(seen "")
    math(EXPR last_prop "${prop_count} - 1")
    foreach(p RANGE 0 ${last_prop})
        string(JSON key GET "${props}" ${p} name)
        string(JSON value GET "${props}" ${p} value)
        if(key STREQUAL "TIMEOUT")
            if(NOT value EQUAL 60)
                message(FATAL_ERROR "${name}: expected 60-second timeout")
            endif()
            list(APPEND seen TIMEOUT)
        elseif(key STREQUAL "WORKING_DIRECTORY")
            if(NOT value STREQUAL workdir)
                message(FATAL_ERROR "${name}: unexpected working directory")
            endif()
            list(APPEND seen WORKING_DIRECTORY)
        elseif(key MATCHES "^FIXTURES_(SETUP|REQUIRED|CLEANUP)$")
            string(JSON n LENGTH "${value}")
            if(NOT key STREQUAL fixture_key OR NOT n EQUAL 1)
                message(FATAL_ERROR "${name}: unexpected fixture property")
            endif()
            string(JSON fixture GET "${value}" 0)
            if(NOT fixture STREQUAL "artplus_pdf_fixture")
                message(FATAL_ERROR "${name}: unexpected fixture name")
            endif()
            list(APPEND seen "${key}")
        endif()
    endforeach()
    foreach(required TIMEOUT WORKING_DIRECTORY ${fixture_key})
        if(NOT required IN_LIST seen)
            message(FATAL_ERROR "${name}: missing ${required}")
        endif()
    endforeach()
endforeach()
message(STATUS "Seven CTest suite contracts verified")
