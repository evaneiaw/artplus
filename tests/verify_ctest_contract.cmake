# cmake -DBUILD_DIR=build-msvc -P tests/verify_ctest_contract.cmake
# Uses CMake/CTest only; does not start Qt/PDFium or modify generated test files.
cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED BUILD_DIR)
    message(FATAL_ERROR "BUILD_DIR is required")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(ctest NAMES ctest HINTS "${cmake_bin}" NO_DEFAULT_PATH REQUIRED)
set(probe "${BUILD_DIR}/tests/contract-probe")
file(MAKE_DIRECTORY "${probe}")
execute_process(COMMAND "${ctest}" --test-dir "${BUILD_DIR}" --show-only=json-v1
    TIMEOUT 15 RESULT_VARIABLE result OUTPUT_VARIABLE discovery ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "CTest discovery failed: ${result}: ${error}")
endif()
function(validate label json expected_result diagnostic)
    set(input "${probe}/${label}.json")
    file(WRITE "${input}" "${json}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}"
        "-DINPUT_FILE=${input}" -P "${CMAKE_CURRENT_LIST_DIR}/check_ctest_contract.cmake"
        TIMEOUT 10 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected_result}" OR
       NOT "${output}${error}" MATCHES "${diagnostic}")
        message(FATAL_ERROR "${label}: unexpected result ${result}: ${output}${error}")
    endif()
endfunction()
validate(actual "${discovery}" 0 "Eight CTest suite contracts verified")
# Mutate JSON copies only. Each control must fail for its intended reason.
string(JSON changed SET "${discovery}" tests 1 name "\"artplus.edit\"")
validate(duplicate "${changed}" 1 "Unexpected or duplicate suite")
string(JSON changed SET "${discovery}" tests 0 command 0 "\"wrong.exe\"")
validate(executable "${changed}" 1 "unexpected command argument 0")
foreach(i RANGE 0 7)
    string(JSON name GET "${discovery}" tests ${i} name)
    string(JSON n LENGTH "${discovery}" tests ${i} properties)
    math(EXPR last "${n} - 1")
    foreach(p RANGE 0 ${last})
        string(JSON key GET "${discovery}" tests ${i} properties ${p} name)
        if(i EQUAL 0 AND key STREQUAL "TIMEOUT")
            string(JSON changed SET "${discovery}" tests ${i} properties ${p} value 0)
            validate(timeout "${changed}" 1 "expected 60-second timeout")
        elseif(i EQUAL 0 AND key STREQUAL "WORKING_DIRECTORY")
            string(JSON changed SET "${discovery}" tests ${i} properties ${p} value "\"wrong\"")
            validate(workdir "${changed}" 1 "unexpected working directory")
        elseif(key STREQUAL "FIXTURES_SETUP" OR key STREQUAL "FIXTURES_REQUIRED")
            string(JSON changed REMOVE "${discovery}" tests ${i} properties ${p})
            validate("missing-fixture-${i}" "${changed}" 1 "missing ${key}")
        endif()
    endforeach()
    if(name MATCHES "^artplus[.](smoke|import|mainwindow)$")
        string(JSON changed SET "${discovery}" tests ${i} command 1 "\"wrong.pdf\"")
        validate("input-${i}" "${changed}" 1 "unexpected command argument 1")
        execute_process(COMMAND "${ctest}" --test-dir "${BUILD_DIR}"
            -R "^${name}$" --show-only=json-v1 TIMEOUT 15
            RESULT_VARIABLE result OUTPUT_VARIABLE filtered ERROR_VARIABLE error)
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "Filtered discovery failed: ${result}: ${error}")
        endif()
        string(JSON count LENGTH "${filtered}" tests)
        set(names "")
        if(NOT count EQUAL 2)
            message(FATAL_ERROR "${name}: expected consumer plus automatic edit fixture")
        endif()
        foreach(f RANGE 0 1)
            string(JSON selected GET "${filtered}" tests ${f} name)
            list(APPEND names "${selected}")
        endforeach()
        if(NOT "artplus.edit" IN_LIST names OR NOT name IN_LIST names)
            message(FATAL_ERROR "${name}: automatic edit fixture not selected")
        endif()
    endif()
endforeach()
message(STATUS "CTest contract passed: actual configuration, 11 negative controls, three filtered fixture selections")
