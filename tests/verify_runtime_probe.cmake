cmake_minimum_required(VERSION 3.24)
if(NOT WIN32)
    message(FATAL_ERROR "This diagnostic requires Windows")
endif()
if(NOT DEFINED BUILD_DIR)
    message(FATAL_ERROR "BUILD_DIR is required")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
set(probe "${BUILD_DIR}/bin/artplus_runtime_probe.exe")
function(check_probe expected_result expected_output)
    execute_process(COMMAND "${probe}" ${ARGN}
        TIMEOUT 10 RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected_result}" OR
       NOT "${output}${error}" MATCHES "${expected_output}")
        message(FATAL_ERROR "Probe control failed (${result}): ${output}${error}")
    endif()
endfunction()
check_probe(0 "LOADED:.*KERNEL32.*UNLOADED" "$ENV{SystemRoot}/System32/kernel32.dll")
set(missing "${BUILD_DIR}/tests/nonexistent-runtime-probe-control.dll")
if(EXISTS "${missing}")
    message(FATAL_ERROR "Missing-DLL control path unexpectedly exists: ${missing}")
endif()
check_probe(1 "FAILED: Win32 126" "${missing}")
check_probe(2 "absolute DLL path is required" "relative.dll")
check_probe(2 "Usage:")
message(STATUS "Runtime probe: load/unload, missing DLL and argument controls passed")
